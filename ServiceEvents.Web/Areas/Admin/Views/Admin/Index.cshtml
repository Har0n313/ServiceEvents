@model ServiceEvents.Web.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Панель администратора";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="admin-dashboard">
    <h1>@ViewData["Title"]</h1>
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    <div class="admin-cards">
        <div class="admin-card">
            <div class="card-title">События</div>
            <div class="card-value">@Model.EventsCount</div>
            <a asp-area="Admin" asp-controller="Events" asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2">Все события</a>
            <a asp-area="Admin" asp-controller="Events" asp-action="Create" class="btn btn-sm btn-primary mt-2">Создать мероприятие</a>
        </div>

        <div class="admin-card">
            <div class="card-title">Пользователи</div>
            <div class="card-value">@Model.UsersCount</div>
            <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2">Все пользователи</a>
            <a asp-area="Admin" asp-controller="Users" asp-action="Create" class="btn btn-sm btn-primary mt-2">Создать пользователя</a>
        </div>

        <div class="admin-card">
            <div class="card-title">Регистрации</div>
            <div class="card-value">@Model.RegistrationsCount</div>
            <a asp-area="Admin" asp-controller="Registrations" asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2">Просмотреть</a>
        </div>
    </div>

    <div class="admin-section">
        <h4>Последние события</h4>
        @if (Model.RecentEvents == null || Model.RecentEvents.Count == 0)
        {
            <div class="alert alert-secondary">Нет событий</div>
        }
        else
        {
            <ul class="admin-list list-group">
                @foreach (var ev in Model.RecentEvents)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@ev.Title</strong>
                            <div class="text-muted small">@ev.StartDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @ev.Status</div>
                        </div>
                        <div>
                            <a class="btn btn-sm btn-outline-secondary me-1" asp-area="Admin" asp-controller="Events" asp-action="Details" asp-route-id="@ev.EventId">Просмотр</a>
                            <a class="btn btn-sm btn-primary me-1" asp-area="Admin" asp-controller="Events" asp-action="Edit" asp-route-id="@ev.EventId">Редактировать</a>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="admin-section">
        <h4>Последние пользователи</h4>
        @if (Model.RecentUsers == null || Model.RecentUsers.Count == 0)
        {
            <div class="alert alert-secondary">Нет пользователей</div>
        }
        else
        {
            <ul class="admin-list list-group">
                @foreach (var u in Model.RecentUsers)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@u.FullName</strong>
                            <div class="text-muted small">@u.Department · @u.Position · @u.Role</div>
                        </div>
                        <div>
                            <a class="btn btn-sm btn-outline-secondary me-1" asp-area="Admin" asp-controller="Users" asp-action="Edit" asp-route-id="@u.UserId">Редактировать</a>
                            <form asp-area="Admin" asp-controller="Users" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Удалить пользователя?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@u.UserId" />
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</div>
