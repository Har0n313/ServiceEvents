@model ServiceEvents.Web.Models.AdminDepartmentViewModel

@{
    ViewData["Title"] = "Добавить департамент";
}

<section class="container service-shell py-5">
    <a asp-area="Admin" asp-controller="Departments" asp-action="Index" class="text-decoration-none">← К департаментам</a>
    <h1 class="mt-3 mb-4">@ViewData["Title"]</h1>
    <div class="card border-0 shadow-sm" style="max-width: 650px">
        <div class="card-body p-4">
            <form asp-area="Admin" asp-controller="Departments" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="alert alert-danger"></div>
                <div class="mb-4">
                    <label asp-for="Name" class="form-label">Название</label>
                    <input asp-for="Name" class="form-control" maxlength="200" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Создать</button>
                <a asp-area="Admin" asp-controller="Departments" asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
            </form>
        </div>
    </div>
</section>
