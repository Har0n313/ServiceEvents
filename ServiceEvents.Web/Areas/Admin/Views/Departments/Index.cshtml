@model IReadOnlyCollection<ServiceEvents.Application.DTOs.DepartmentDTO.DepartmentResponse>

@{
    ViewData["Title"] = "Департаменты";
}

<section class="container service-shell py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <span class="service-eyebrow"><span></span>СТРУКТУРА КОМАНДЫ</span>
            <h1 class="mt-3 mb-2">Департаменты</h1>
            <p class="text-muted mb-0">Управляйте департаментами, к которым привязываются пользователи и мероприятия.</p>
        </div>
        <a asp-area="Admin" asp-controller="Departments" asp-action="Create" class="btn btn-primary">Добавить департамент</a>
    </div>

    @if (TempData["Message"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-secondary">Департаменты ещё не созданы.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr><th>Название</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var department in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@department.Name</td>
                            <td class="text-end">
                                <a asp-area="Admin" asp-controller="Departments" asp-action="Edit"
                                   asp-route-id="@department.DepartmentId" class="btn btn-sm btn-outline-primary">Изменить</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
