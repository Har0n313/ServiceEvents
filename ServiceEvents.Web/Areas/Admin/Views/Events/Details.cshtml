@model ServiceEvents.Application.DTOs.EventDTO.EventResponse

@{
    ViewData["Title"] = "Детали события (админ)";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="container mt-4">
    <a class="btn btn-link mb-3" asp-area="Admin" asp-controller="Events" asp-action="Index">← Назад</a>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    <h1>@Model.Title</h1>

    <p class="text-muted">@Model.StartDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @Model.Status.ToRussian()</p>
    @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
    {
        <img src="@Url.Content(Model.ImagePath)" alt="@Model.Title" class="img-fluid rounded mb-3" style="max-height: 360px; object-fit: cover;" />
    }

    <div class="mt-3">
        <a asp-area="Admin" asp-controller="Events" asp-action="Edit" asp-route-id="@Model.EventId" class="btn btn-primary me-2">Редактировать</a>

        <form asp-area="Admin" asp-controller="Events" asp-action="Publish" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.EventId" />
            <button type="submit" class="btn btn-success me-2">Опубликовать</button>
        </form>

        <form asp-area="Admin" asp-controller="Events" asp-action="CloseRegistration" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.EventId" />
            <button type="submit" class="btn btn-warning me-2">Закрыть регистрацию</button>
        </form>

        <form asp-area="Admin" asp-controller="Events" asp-action="Cancel" method="post" class="d-inline" onsubmit="return confirm('Отменить событие?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.EventId" />
            <button type="submit" class="btn btn-danger">Отменить</button>
        </form>
        <form asp-area="Admin" asp-controller="Events" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Удалить событие без возможности восстановления?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.EventId" />
            <button type="submit" class="btn btn-outline-danger">Удалить</button>
        </form>
    </div>

    <div class="mt-4">
        <h4>Описание</h4>
        <p>@Model.Description</p>
        @if (ViewData["EventProperties"] is IReadOnlyCollection<ServiceEvents.Web.Models.EventPropertyValueViewModel> properties && properties.Count > 0)
        {
            <h4>Характеристики</h4>
            <dl>
                @foreach (var property in properties)
                {
                    <dt>@property.Name</dt>
                    <dd>@property.Value</dd>
                }
            </dl>
        }
    </div>
</div>
