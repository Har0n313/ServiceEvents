@model IReadOnlyCollection<ServiceEvents.Application.DTOs.EventPropertyDTO.EventPropertyResponse>

@{
    ViewData["Title"] = "Характеристики мероприятий";
}

<section class="container service-shell py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <span class="service-eyebrow"><span></span>НАСТРОЙКИ МЕРОПРИЯТИЙ</span>
            <h1 class="mt-3 mb-2">Характеристики</h1>
            <p class="text-muted mb-0">Создавайте поля, которые организаторы смогут заполнять для событий.</p>
        </div>
        <a asp-area="Admin" asp-controller="Properties" asp-action="Create" class="btn btn-primary">Добавить характеристику</a>
    </div>

    @if (TempData["Message"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-secondary">Характеристики ещё не созданы.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Название</th>
                        <th>Тип значения</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var property in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@property.Name</td>
                            <td>@property.DataType.ToRussian()</td>
                            <td class="text-end">
                                <a asp-area="Admin" asp-controller="Properties" asp-action="Edit" asp-route-id="@property.PropertyId" class="btn btn-sm btn-outline-primary">Изменить</a>
                                <form asp-area="Admin" asp-controller="Properties" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Удалить характеристику и её значения?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@property.PropertyId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
