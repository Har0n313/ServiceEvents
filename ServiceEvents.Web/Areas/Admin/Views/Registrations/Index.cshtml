@model IReadOnlyCollection<ServiceEvents.Web.Models.AdminRegistrationViewModel>

@{
    ViewData["Title"] = "Регистрации";
}

<div class="container mt-4">
    <h1>Регистрации на события</h1>

    @if (Model.Count == 0)
    {
        <div class="alert alert-secondary">Регистраций пока нет.</div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Событие</th>
                    <th>Пользователь</th>
                    <th>Дата регистрации</th>
                    <th>Статус</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var registration in Model)
                {
                    <tr>
                        <td>@registration.EventTitle</td>
                        <td>@registration.UserName</td>
                        <td>@registration.RegisteredAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@registration.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
