@model IReadOnlyCollection<ServiceEvents.Web.Models.EmployeeEventViewModel>
@using ServiceEvents.Domain.Enums

@{
    ViewData["Title"] = "Мероприятия";
}

<section class="container service-shell py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <span class="service-eyebrow"><span></span>СОБЫТИЯ ДЛЯ КОМАНДЫ</span>
            <h1 class="mt-3 mb-2">Откройте для себя новое</h1>
            <p class="text-muted mb-0">Выбирайте мероприятие и присоединяйтесь к коллегам.</p>
        </div>
        <a asp-area="Employee" asp-controller="Events" asp-action="MyRegistrations" class="btn btn-outline-secondary">Мои регистрации</a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body py-5 text-center">
                <h2 class="h5">Сейчас нет открытых мероприятий</h2>
                <p class="text-muted mb-0">Загляните позже — новые события появятся здесь.</p>
            </div>
        </div>
    }
    else
    {
        <div class="employee-event-grid">
            @foreach (var item in Model)
            {
                var isRegistered = item.RegistrationStatus == RegistrationStatus.Active;
                <article class="employee-event-card">
                    @if (EventImagePath.GetSource(item.Event.ImagePath) is string imageSource)
                    {
                        <img class="employee-event-image" src="@Url.Content(imageSource)" alt="@item.Event.Title" loading="lazy" />
                    }
                    <div class="employee-event-card-top">
                        <span class="employee-event-tag">МЕРОПРИЯТИЕ</span>
                        <span class="employee-event-date">@DateTime.SpecifyKind(item.Event.StartDate, DateTimeKind.Utc).ToLocalTime().ToString("dd.MM.yyyy")</span>
                    </div>
                    <h2>@item.Event.Title</h2>
                    <p class="employee-event-description">@item.Event.Description</p>
                    <div class="employee-event-meta">
                        <span>@DateTime.SpecifyKind(item.Event.StartDate, DateTimeKind.Utc).ToLocalTime().ToString("HH:mm")</span>
                        <span>@(string.IsNullOrWhiteSpace(item.Event.Location) ? "Место уточняется" : item.Event.Location)</span>
                    </div>
                    @if (item.Properties.Count > 0)
                    {
                        <div class="employee-event-properties">
                            @foreach (var property in item.Properties.Take(3))
                            {
                                <span><strong>@property.Name:</strong> @property.Value</span>
                            }
                        </div>
                    }
                    <div class="employee-event-actions">
                        <a asp-area="Employee" asp-controller="Events" asp-action="Details" asp-route-id="@item.Event.EventId" class="employee-event-details">Подробнее <span aria-hidden="true">→</span></a>
                        @if (isRegistered)
                        {
                            <span class="employee-registered-badge">Вы записаны</span>
                        }
                        else
                        {
                            <form asp-area="Employee" asp-controller="Events" asp-action="Register" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Event.EventId" />
                                <button type="submit" class="btn btn-primary btn-sm">Записаться</button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>
