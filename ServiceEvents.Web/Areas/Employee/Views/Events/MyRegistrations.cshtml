@model IReadOnlyCollection<ServiceEvents.Web.Models.EmployeeRegistrationViewModel>
@using ServiceEvents.Domain.Enums

@{
    ViewData["Title"] = "Мои регистрации";
}

<section class="container service-shell py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <span class="service-eyebrow"><span></span>ВАШИ СОБЫТИЯ</span>
            <h1 class="mt-3 mb-2">Мои регистрации</h1>
            <p class="text-muted mb-0">Здесь собраны мероприятия, на которые вы записывались.</p>
        </div>
        <a asp-area="Employee" asp-controller="Events" asp-action="Index" class="btn btn-outline-secondary">Все мероприятия</a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body py-5 text-center">
                <h2 class="h5">Регистраций пока нет</h2>
                <p class="text-muted">Найдите интересное событие и присоединяйтесь.</p>
                <a asp-area="Employee" asp-controller="Events" asp-action="Index" class="btn btn-primary">Посмотреть мероприятия</a>
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Мероприятие</th>
                        <th>Дата события</th>
                        <th>Дата регистрации</th>
                        <th>Статус записи</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var registration in Model)
                    {
                        <tr>
                            <td>
                                <a asp-area="Employee" asp-controller="Events" asp-action="Details" asp-route-id="@registration.Event.EventId" class="fw-semibold text-decoration-none">
                                    @registration.Event.Title
                                </a>
                            </td>
                            <td>@DateTime.SpecifyKind(registration.Event.StartDate, DateTimeKind.Utc).ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@DateTime.SpecifyKind(registration.RegisteredAt, DateTimeKind.Utc).ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                @if (registration.Status == RegistrationStatus.Active)
                                {
                                    <span class="employee-registered-badge">Активна</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-light border">@registration.Status.ToRussian()</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (registration.Status == RegistrationStatus.Active && registration.Event.Status == EventStatus.Published)
                                {
                                    <form asp-area="Employee" asp-controller="Events" asp-action="CancelRegistration" method="post" class="d-inline" onsubmit="return confirm('Отменить регистрацию?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@registration.Event.EventId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Отменить</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
