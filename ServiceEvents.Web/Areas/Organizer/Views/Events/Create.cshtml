@model ServiceEvents.Web.Models.CreateEventViewModel

@{
    ViewData["Title"] = "Создать мероприятие";
}

<div class="container mt-4">
    <div class="mb-4">
        <a asp-area="Organizer" asp-controller="Events" asp-action="Index" class="text-decoration-none">← Мои мероприятия</a>
        <h1 class="mt-3">@ViewData["Title"]</h1>
        <p class="text-muted">Заполните информацию о мероприятии. Оно будет создано от вашего имени.</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-area="Organizer" asp-controller="Events" asp-action="Create" method="post" class="event-create-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="startDateOffsetMinutes" />
                <input type="hidden" name="endDateOffsetMinutes" />
                <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Название</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Описание</label>
                    <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartDate" class="form-label">Дата и время начала</label>
                        <div class="event-date-field">
                            <input asp-for="StartDate" type="text" class="form-control event-date-input" placeholder="__.__.____ __:__" maxlength="16" inputmode="numeric" autocomplete="off" />
                            <div class="event-calendar-control">
                                <button type="button" class="btn btn-outline-secondary event-calendar-button">Календарь</button>
                                <input type="datetime-local" class="event-date-picker" aria-label="Выбрать дату и время начала" tabindex="-1" />
                            </div>
                        </div>
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="EndDate" class="form-label">Дата и время окончания</label>
                        <div class="event-date-field">
                            <input asp-for="EndDate" type="text" class="form-control event-date-input" placeholder="__.__.____ __:__" maxlength="16" inputmode="numeric" autocomplete="off" />
                            <div class="event-calendar-control">
                                <button type="button" class="btn btn-outline-secondary event-calendar-button">Календарь</button>
                                <input type="datetime-local" class="event-date-picker" aria-label="Выбрать дату и время окончания" tabindex="-1" />
                            </div>
                        </div>
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Location" class="form-label">Место проведения</label>
                        <input asp-for="Location" class="form-control" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="MaxParticipants" class="form-label">Максимум участников</label>
                        <input asp-for="MaxParticipants" type="number" min="1" class="form-control" />
                        <span asp-validation-for="MaxParticipants" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-4">
                    <label asp-for="ImagePath" class="form-label">Путь к изображению</label>
                    <input asp-for="ImagePath" class="form-control" />
                    <span asp-validation-for="ImagePath" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Создать мероприятие</button>
                <a asp-area="Organizer" asp-controller="Events" asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
            </form>
        </div>
    </div>
</div>
