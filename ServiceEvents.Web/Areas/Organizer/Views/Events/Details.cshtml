@model ServiceEvents.Application.DTOs.EventDTO.EventResponse
@using ServiceEvents.Domain.Enums

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <a asp-area="Organizer" asp-controller="Events" asp-action="Index" class="text-decoration-none">← Мои мероприятия</a>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success mt-3">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-3">@TempData["Error"]</div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mt-4">
        <div>
            <span class="badge text-bg-light border">@Model.Status.ToRussian()</span>
            <h1 class="mt-2">@Model.Title</h1>
            <p class="text-muted">
                @DateTime.SpecifyKind(Model.StartDate, DateTimeKind.Utc).ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                @if (Model.EndDate is { } endDate)
                {
                    <span> — @DateTime.SpecifyKind(endDate, DateTimeKind.Utc).ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                }
                <span> · @(string.IsNullOrWhiteSpace(Model.Location) ? "Место не указано" : Model.Location)</span>
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-area="Organizer" asp-controller="Events" asp-action="Edit" asp-route-id="@Model.EventId" class="btn btn-outline-primary">Редактировать</a>
            <a asp-area="Organizer" asp-controller="Events" asp-action="Participants" asp-route-id="@Model.EventId" class="btn btn-outline-secondary">Участники</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm mt-3">
        <div class="card-body p-4">
            @if (EventImagePath.GetSource(Model.ImagePath) is string imageSource)
            {
                <img src="@Url.Content(imageSource)" alt="@Model.Title" class="event-detail-image" />
            }
            <h2 class="h5">Описание</h2>
            <p class="mb-0" style="white-space: pre-line">@Model.Description</p>
            @if (ViewData["EventProperties"] is IReadOnlyCollection<ServiceEvents.Web.Models.EventPropertyValueViewModel> properties && properties.Count > 0)
            {
                <h2 class="h5 mt-4">Характеристики</h2>
                <dl class="mb-0">
                    @foreach (var property in properties)
                    {
                        <dt>@property.Name</dt>
                        <dd>@property.Value</dd>
                    }
                </dl>
            }
            @if (Model.MaxParticipants is { } maxParticipants)
            {
                <p class="mt-3 mb-0 text-muted">Максимум участников: @maxParticipants</p>
            }
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mt-4">
        @if (Model.Status == EventStatus.Draft)
        {
            <form asp-area="Organizer" asp-controller="Events" asp-action="Publish" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.EventId" />
                <button type="submit" class="btn btn-primary">Опубликовать</button>
            </form>
        }
        @if (Model.Status == EventStatus.Published)
        {
            <form asp-area="Organizer" asp-controller="Events" asp-action="CloseRegistration" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.EventId" />
                <button type="submit" class="btn btn-outline-secondary">Закрыть регистрацию</button>
            </form>
        }
        @if (Model.Status is EventStatus.Draft or EventStatus.Published or EventStatus.RegistrationClosed)
        {
            <form asp-area="Organizer" asp-controller="Events" asp-action="Cancel" method="post" onsubmit="return confirm('Отменить мероприятие?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.EventId" />
                <button type="submit" class="btn btn-outline-danger">Отменить</button>
            </form>
        }
        <form asp-area="Organizer" asp-controller="Events" asp-action="Delete" method="post" onsubmit="return confirm('Удалить мероприятие и все связанные регистрации?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.EventId" />
            <button type="submit" class="btn btn-danger">Удалить</button>
        </form>
    </div>
</div>
