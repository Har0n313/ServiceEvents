@model ServiceEvents.Application.DTOs.EventDTO.UpdateEventRequest

@{
    ViewData["Title"] = "Редактировать мероприятие";
}

<div class="container mt-4">
    <div class="mb-4">
        <a asp-area="Organizer" asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="text-decoration-none">← К мероприятию</a>
        <h1 class="mt-3">@ViewData["Title"]</h1>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-area="Organizer" asp-controller="Events" asp-action="Edit" method="post" class="event-edit-form">
                @Html.AntiForgeryToken()
                <input asp-for="EventId" type="hidden" />
                <input type="hidden" name="startDateOffsetMinutes" />
                <input type="hidden" name="endDateOffsetMinutes" />
                <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Название</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Описание</label>
                    <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartDate" class="form-label">Дата и время начала</label>
                        <input asp-for="StartDate" type="datetime-local" class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="EndDate" class="form-label">Дата и время окончания</label>
                        <input asp-for="EndDate" type="datetime-local" class="form-control" />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Location" class="form-label">Место проведения</label>
                        <input asp-for="Location" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="MaxParticipants" class="form-label">Максимум участников</label>
                        <input asp-for="MaxParticipants" type="number" min="1" class="form-control" />
                    </div>
                </div>
                <div class="mb-4">
                    <label asp-for="ImagePath" class="form-label">Путь к изображению</label>
                    <input asp-for="ImagePath" class="form-control" />
                </div>

                <button type="submit" class="btn btn-primary">Сохранить</button>
                <a asp-area="Organizer" asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="btn btn-outline-secondary">Отмена</a>
            </form>
        </div>
    </div>
</div>

<script>
    document.querySelector('.event-edit-form').addEventListener('submit', function () {
        const startDate = this.querySelector('[name="StartDate"]').value;
        const endDate = this.querySelector('[name="EndDate"]').value;
        this.querySelector('[name="startDateOffsetMinutes"]').value =
            startDate ? new Date(startDate).getTimezoneOffset() : '';
        this.querySelector('[name="endDateOffsetMinutes"]').value =
            endDate ? new Date(endDate).getTimezoneOffset() : '';
    });
</script>
